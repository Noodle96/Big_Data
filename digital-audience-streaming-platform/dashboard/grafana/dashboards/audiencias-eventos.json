{
  "uid": "audiencias-eventos",
  "title": "Audiencias Digitales - Dashboard (Fase 6)",
  "description": "Los 10 paneles pedidos por el enunciado, alimentados por AudienciasDigitalesJob (Fase 4).",
  "tags": ["audiencias", "kafka", "flink", "proyecto-final"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Eventos por tipo",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT event_type, SUM(event_count) AS total FROM eventos_por_tipo WHERE $__timeFilter(window_start) GROUP BY event_type ORDER BY total DESC",
          "rawQuery": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie",
        "reduceOptions": { "values": true, "calcs": [], "fields": "" }
      }
    },
    {
      "id": 2,
      "title": "Tendencias temporales (eventos por tipo)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "time_series",
          "rawSql": "SELECT window_start AS \"time\", event_type AS \"metric\", event_count AS \"value\" FROM eventos_por_tipo WHERE $__timeFilter(window_start) ORDER BY window_start",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "Eventos por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "time_series",
          "rawSql": "SELECT window_start AS \"time\", eventos_por_segundo AS \"value\" FROM resumen_ventana WHERE $__timeFilter(window_start) ORDER BY window_start",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "Conversion de compras",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT AVG(conversion) * 100 AS conversion_pct FROM resumen_ventana WHERE $__timeFilter(window_start)",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "title": "Usuarios activos",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT usuarios_activos FROM resumen_ventana WHERE $__timeFilter(window_start) ORDER BY window_start DESC LIMIT 1",
          "rawQuery": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto" }
    },
    {
      "id": 6,
      "title": "Audiencias detectadas",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT audiencia, COUNT(DISTINCT user_id) AS usuarios FROM (SELECT DISTINCT ON (user_id) user_id, audiencia FROM audiencias WHERE $__timeFilter(event_time) ORDER BY user_id, event_time DESC) t GROUP BY audiencia ORDER BY usuarios DESC",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Productos mas visitados",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT product, SUM(views_count) AS total FROM productos_vistos WHERE $__timeFilter(window_start) GROUP BY product ORDER BY total DESC LIMIT 10",
          "rawQuery": true
        }
      ],
      "options": { "orientation": "horizontal", "xField": "product" }
    },
    {
      "id": 8,
      "title": "Productos mas comprados",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT product, SUM(purchases_count) AS total FROM productos_comprados WHERE $__timeFilter(window_start) GROUP BY product ORDER BY total DESC LIMIT 10",
          "rawQuery": true
        }
      ],
      "options": { "orientation": "horizontal", "xField": "product" }
    },
    {
      "id": 9,
      "title": "Compras por region",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT city, SUM(purchases_count) AS total FROM compras_por_region WHERE $__timeFilter(window_start) GROUP BY city ORDER BY total DESC",
          "rawQuery": true
        }
      ],
      "options": { "orientation": "horizontal", "xField": "city" }
    },
    {
      "id": 10,
      "title": "Alertas recientes",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "postgres-audiencias" },
          "format": "table",
          "rawSql": "SELECT created_at AS \"time\", tipo, mensaje, user_id FROM alertas WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 50",
          "rawQuery": true
        }
      ]
    }
  ]
}
